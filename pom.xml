<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>VisorImagenes</groupId>
  <artifactId>VisorImagenes</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <properties>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      <twelvemonkeys.version>3.10.1</twelvemonkeys.version>
      <javafx.platform>win</javafx.platform>
  </properties>

  <dependencies>

  	<!-- ======================================================= -->
    <!-- === JavaFX 3D para previsualización interactiva STL  === -->
    <!-- ======================================================= -->
    <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-graphics</artifactId>
        <version>21</version>
        <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-swing</artifactId>
        <version>21</version>
        <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-base</artifactId>
        <version>21</version>
        <classifier>${javafx.platform}</classifier>
    </dependency>

  	<!-- ======================================================= -->
    <!-- === LIBRERÍA PARA LEER METADATOS (EXIF)             === -->
    <!-- ======================================================= -->
    <dependency>
        <groupId>com.drewnoakes</groupId>
        <artifactId>metadata-extractor</artifactId>
        <version>2.19.0</version>
    </dependency>
    
    <!-- ======================================================= -->
    <!-- === LIBRERÍA PARA MANEJAR ARCHIVOS JSON             === -->
    <!-- ======================================================= -->
    <dependency>
    	<groupId>com.google.code.gson</groupId>
    	<artifactId>gson</artifactId>
    	<version>2.10.1</version>
	</dependency>
  
  	<!-- ======================================================= -->
	<!-- === DEPENDENCIAS DE TWELVEMONKEYS PARA IMAGEIO      === -->
	<!-- ======================================================= -->
	<!-- Common base library -->
	<dependency>
        <groupId>com.twelvemonkeys.common</groupId>
        <artifactId>common-lang</artifactId>
        <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
        <groupId>com.twelvemonkeys.common</groupId>
        <artifactId>common-io</artifactId>
        <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
        <groupId>com.twelvemonkeys.common</groupId>
        <artifactId>common-image</artifactId>
        <version>${twelvemonkeys.version}</version>
    </dependency>

    <!-- ImageIO plugins -->
    <dependency>
        <groupId>com.twelvemonkeys.imageio</groupId>
        <artifactId>imageio-core</artifactId>
        <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
        <groupId>com.twelvemonkeys.imageio</groupId>
        <artifactId>imageio-jpeg</artifactId> <!-- Soporte mejorado para JPEG, incluyendo CMYK -->
        <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
        <groupId>com.twelvemonkeys.imageio</groupId>
        <artifactId>imageio-bmp</artifactId> <!-- Soporte mejorado para BMP -->
        <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
        <groupId>com.twelvemonkeys.imageio</groupId>
        <artifactId>imageio-tiff</artifactId> <!-- Soporte para TIFF, que no viene por defecto -->
        <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
        <groupId>com.twelvemonkeys.imageio</groupId>
        <artifactId>imageio-psd</artifactId> <!-- Soporte básico para PSD (Photoshop) -->
        <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
	    <groupId>com.twelvemonkeys.imageio</groupId>
	    <artifactId>imageio-webp</artifactId>
	    <version>${twelvemonkeys.version}</version>
	</dependency>
	<dependency>
	    <groupId>com.twelvemonkeys.imageio</groupId>
	    <artifactId>imageio-tga</artifactId>
	    <version>${twelvemonkeys.version}</version>
	</dependency>
	<dependency>
	    <groupId>com.twelvemonkeys.imageio</groupId>
	    <artifactId>imageio-pcx</artifactId>
	    <version>${twelvemonkeys.version}</version>
	</dependency>

  <!-- ======================================================= -->
  <!-- FlatLaf + Flatlaf-Extras-->
  <!-- ======================================================= -->
    <dependency>
        <groupId>com.formdev</groupId>
        <artifactId>flatlaf</artifactId>
        <version>3.4.1</version>
    </dependency>
    
    <dependency>
    	<groupId>com.formdev</groupId>
    	<artifactId>flatlaf-extras</artifactId>
    	<version>3.4.1</version> <!-- Usa la misma versión que tengas de flatlaf -->
	</dependency>
	
	<dependency>
        <groupId>com.formdev</groupId>
         <artifactId>flatlaf-swingx</artifactId>
        <version>3.4.1</version>
    </dependency>
    
    <dependency>
        <groupId>org.swinglabs.swingx</groupId>
        <artifactId>swingx-all</artifactId>
        <version>1.6.4</version> <!-- Esta es una versión estable y común -->
    </dependency>
    
    <dependency>
    	<groupId>com.formdev</groupId>
    	<artifactId>flatlaf-intellij-themes</artifactId>
    	<version>3.4.1</version>
	</dependency>
	
	<!-- ======================================================= -->
    <!-- Thumbnailator - generación de miniaturas -->
    <!-- ======================================================= -->
    <dependency>
        <groupId>net.coobird</groupId>
        <artifactId>thumbnailator</artifactId>
        <version>0.4.20</version>
    </dependency>

	<!-- ======================================================= -->
    <!-- SLF4J + Logback -->
    <!-- ======================================================= -->
    <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>2.0.12</version>
    </dependency>
    <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>1.4.14</version>
    </dependency>
    
    <!-- ======================================================= -->
    <!-- === CALIDAD DE VIDA Y RENDIMIENTO                   === -->
    <!-- Para un sistema de caché en memoria de alto rendimiento -->
    <dependency>
        <groupId>com.github.ben-manes.caffeine</groupId>
        <artifactId>caffeine</artifactId>
        <version>3.1.8</version>
    </dependency>

    <!-- ======================================================= -->
    <!-- === BASE DE DATOS (FUTURO CATALOGADOR)              === -->
    <!-- ======================================================= -->
    <!-- Driver JDBC para la base de datos embebida SQLite -->
    <dependency>
    	<groupId>org.xerial</groupId>
    	<artifactId>sqlite-jdbc</artifactId>
    	<version>3.50.3.0</version> 
	</dependency>

    <!-- Librería para interactuar con la BBDD de forma más fluida -->
    <dependency>
        <groupId>org.jdbi</groupId>
        <artifactId>jdbi3-core</artifactId>
        <version>3.45.1</version>
    </dependency>
    <dependency>
        <groupId>org.jdbi</groupId>
        <artifactId>jdbi3-sqlobject</artifactId>
        <version>3.45.1</version>
    </dependency>
    
    <!-- ======================================================= -->
    <!-- === GENERACIÓN DE PDFS (Apache PDFBox 3.x)          === -->
    <!-- ======================================================= -->
    <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
        <version>3.0.5</version>
    </dependency>

    <!-- ======================================================= -->
    <!-- === COMPRESIÓN (Apache Commons Compress 1.26+)      === -->
    <!-- ======================================================= -->
    <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>1.26.1</version>
    </dependency>
    
    <!-- Soporte 7z para commons-compress -->
    <dependency>
        <groupId>org.tukaani</groupId>
        <artifactId>xz</artifactId>
        <version>1.9</version>
    </dependency>
    
    <!-- Soporte para el formato .rar (Junrar) -->
    <dependency>
        <groupId>com.github.junrar</groupId>
        <artifactId>junrar</artifactId>
        <version>7.5.8</version>
    </dependency>
    
  </dependencies>

  <build>
    <!-- HEMOS QUITADO LA LÍNEA <directory> DE AQUÍ PARA QUE ECLIPSE NO SE ROMPA -->

    <sourceDirectory>src</sourceDirectory>
    <resources>
      <resource>
        <directory>src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>resources</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>lib/bin/7z</directory>
        <targetPath>bin/7z</targetPath>
      </resource>
    </resources>
    
    <plugins>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.13.0</version>
            <configuration>
                <release>21</release>
            </configuration>
        </plugin>

        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.5.2</version>
            <executions>
                <execution>
                    <phase>package</phase>
                    <goals>
                        <goal>shade</goal>
                    </goals>
                    <configuration>
                        <outputDirectory>D:/Descargas/VisorV2</outputDirectory>
                        <finalName>VisorV2</finalName>
                        <artifactSet>
                        <excludes>
                            <exclude>org.openjfx:javafx-*</exclude>
                        </excludes>
                    </artifactSet>
                    <transformers>
                            <!-- Transformer 1: Para la clase principal -->
                            <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                <mainClass>principal.VisorV2</mainClass>
                                <manifestEntries>
                                    <Add-Opens>java.base/java.nio java.base/java.lang java.base/java.lang.reflect java.base/java.util</Add-Opens>
                                </manifestEntries>
                            </transformer>
                            <!-- Transformer 2: CRÍTICO para que funcionen TwelveMonkeys y SQLite en el JAR -->
                            <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                        </transformers>
                        <!-- Filtro para evitar errores de firmas de seguridad al fusionar los JARs -->
                        <filters>
                            <filter>
                                <artifact>*:*</artifact>
                                <excludes>
                                    <exclude>META-INF/*.SF</exclude>
                                    <exclude>META-INF/*.DSA</exclude>
                                    <exclude>META-INF/*.RSA</exclude>
                                </excludes>
                            </filter>
                        </filters>
                    </configuration>
                </execution>
            </executions>
        </plugin>

        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.7.1</version>
            <executions>
                <execution>
                    <id>copy-javafx</id>
                    <phase>package</phase>
                    <goals>
                        <goal>copy-dependencies</goal>
                    </goals>
                    <configuration>
                        <includeGroupIds>org.openjfx</includeGroupIds>
                        <includeClassifiers>${javafx.platform}</includeClassifiers>
                        <outputDirectory>D:/Descargas/VisorV2/lib</outputDirectory>
                        <excludeTransitive>false</excludeTransitive>
                    </configuration>
                </execution>
            </executions>
        </plugin>
    </plugins>
  </build>
</project>