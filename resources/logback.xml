<configuration>

    <!-- =========================================================== -->
    <!-- APPENDER: ERROR  →  rojo negrita                            -->
    <!-- =========================================================== -->
    <appender name="CONSOLE_ERROR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%boldRed(%-5level %logger{36} - %msg%n)</pattern>
        </encoder>
    </appender>

    <!-- =========================================================== -->
    <!-- APPENDER: WARN   →  amarillo                                -->
    <!-- =========================================================== -->
    <appender name="CONSOLE_WARN" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%yellow(%-5level %logger{36} - %msg%n)</pattern>
        </encoder>
    </appender>

    <!-- =========================================================== -->
    <!-- APPENDER: INFO / DEBUG / TRACE  →  azul / cyan / blanco    -->
    <!-- (se excluyen ERROR y WARN para que no se dupliquen)         -->
    <!-- =========================================================== -->
    <appender name="CONSOLE_INFO" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <!-- Excluir ERROR -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <!-- Excluir WARN  -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>DENY</onMatch>
            <onMismatch>ACCEPT</onMismatch>
        </filter>
        <encoder>
            <!-- INFO en azul, DEBUG/TRACE en cyan (el nivel define el color) -->
            <pattern>%blue(%-5level) %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- =========================================================== -->
    <!-- Cierre de aplicación: mensajes INFO visibles en consola     -->
    <!-- (el root en WARN oculta el resto de INFO del programa)       -->
    <!-- =========================================================== -->
    <logger name="controlador.VisorController" level="INFO"/>
    <logger name="controlador.GeneralController" level="INFO"/>
    <logger name="servicios.db.DatabaseManager" level="INFO"/>
    
    <!-- Silenciar mensajes molestos de PDFBox sobre el soporte de memoria unmapping que no son fallos reales -->
    <logger name="org.apache.pdfbox.io.IOUtils" level="OFF"/>

    <!-- =========================================================== -->
    <!-- ROOT: nivel mínimo WARN. Añade DEBUG si necesitas depurar.  -->
    <!-- =========================================================== -->
    <root level="DEBUG">
        <appender-ref ref="CONSOLE_ERROR" />
        <appender-ref ref="CONSOLE_WARN"  />
        <appender-ref ref="CONSOLE_INFO"  />
    </root>

</configuration>